<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <RollForward>LatestMajor</RollForward>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;publish-dotnet\**;release\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Small)' == 'true'">
    <SelfContained>false</SelfContained>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.0" />
  </ItemGroup>

  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="UI\**\*" LogicalName="UI/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Kit\**\*" LogicalName="Kit/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
    <Compile Remove="Kit\**" />
    <None Remove="Kit\**;UI\**;Docs\**" />
  </ItemGroup>

</Project>
